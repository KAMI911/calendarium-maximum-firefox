#. settings-schema.json->date-format-custom->tooltip
msgid "strftime codes: %A=full weekday  %a=short weekday  %d=day  %B=full month  %b=short month  %Y=4-digit year  %y=2-digit year  %m=month number  %j=day of year  %H=hour(24h)  %I=hour(12h)  %M=minute  %p=AM/PM.  Example: %Y. %B %d., %A"
msgstr "Codici strftime: %A=giorno della settimana completo  %a=giorno della settimana breve  %d=giorno  %B=mese completo  %b=mese breve  %Y=anno a 4 cifre  %y=anno a 2 cifre  %m=numero del mese  %j=giorno dell'anno  %H=ora(24h)  %I=ora(12h)  %M=minuto  %p=AM/PM.  Esempio: %Y. %B %d., %A"

